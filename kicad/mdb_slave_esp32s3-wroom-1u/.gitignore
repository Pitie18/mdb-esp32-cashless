# Ignore everything by default
*

# Keep the core KiCad project files
!*.kicad_pcb
!*.kicad_pro
!*.kicad_sch
!*.md

# Keep the project-local 3D models (referenced via ${KIPRJMOD}/3dmodels)
!3dmodels/
!3dmodels/**

# Keep this .gitignore
!.gitignore

# Keep the licence
!LICENSE

# Keep the fabrication Gerber archives
!gerber_to_order/
!gerber_to_order/**

# Keep the interactive BOM (InteractiveHtmlBom export)
!bom/
!bom/ibom.html