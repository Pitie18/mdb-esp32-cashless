# Ignore everything by default
*

# Keep the core KiCad project files
!*.kicad_pcb
!*.kicad_pro
!*.kicad_sch
!*.md

# Keep this .gitignore
!.gitignore

# Keep the licence
!LICENSE

# Keep the fabrication Gerber archives
!gerber_to_order/
!gerber_to_order/**

# Keep the interactive BOM (InteractiveHtmlBom export)
!bom/
!bom/ibom.html

# Keep the board render shown in the READMEs
!mdb_slave_esp32s3-wroom-1u.png
