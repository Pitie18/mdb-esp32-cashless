# Environment variables for Supabase CLI (supabase start / supabase functions serve)
# Referenced by env() in config.toml [edge_runtime.secrets]
#
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Or run the credential generator which updates this automatically:
#   cd Docker && ./mqtt-credentials.sh

# How the EDGE FUNCTIONS reach the broker. They run inside the Supabase CLI's
# own Docker network, which has no `broker` service — so unlike the production
# compose stack this cannot be the service name, and it must never be
# `localhost` either (inside a container that is the container itself).
# macOS / Windows: host.docker.internal. Linux: your LAN IP.
MQTT_HOST=host.docker.internal

# WebSocket port of the broker. The edge runtime sandboxes Deno.connect(), so
# edge functions publish over ws:// on 9001 while the forwarder uses TCP 1883.
MQTT_WS_PORT=9001

# Shared secret between the MQTT forwarder and the mqtt-webhook edge function
MQTT_WEBHOOK_SECRET=change-me-to-a-random-secret

# MQTT admin credentials (used by edge functions to publish to broker)
MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASS=admin

# Public Supabase URL reachable by ESP32 devices (LAN IP + CLI API port)
# Used by trigger-ota to build firmware download URLs the device can fetch
# Note: cannot use SUPABASE_ prefix — the CLI reserves it for internal use
PUBLIC_SUPABASE_URL=http://localhost:54321

# How the DEVICES reach the broker: returned by claim-device during
# provisioning and stored in the ESP32's NVS. Not a container-internal name —
# `localhost` would point the device at itself. Use the LAN IP of this host.
MQTT_PUBLIC_HOST=10.0.1.181
MQTT_PUBLIC_PORT=1883

# VAPID keys for Web Push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# GitHub repo for firmware release imports (owner/repo format, leave empty to disable)
GITHUB_FIRMWARE_REPO=

# Firebase Cloud Messaging (FCM) — for native iOS/Android push notifications
# Paste the full JSON content of your Firebase service account key.
# Leave empty to disable native push (web push via VAPID still works).
FCM_SERVICE_ACCOUNT_JSON=

# Apple Push Notification Service (APNs) — for native iOS push notifications
# Get these from Apple Developer Portal → Keys → APNs key.
# APNS_PRIVATE_KEY: paste the .p8 file contents.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.vmflow.VMflow
APNS_PRODUCTION=false
