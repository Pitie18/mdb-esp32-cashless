# VMflow iOS release lanes.
#
# Signing: App Store Connect API key + Xcode cloud signing. No cert repo.
# The key MUST have the Admin role — cloud-managed distribution certificates
# cannot be granted to lesser API keys (Apple forums thread 698117).
#
# Cloud-signing auth: gym's `xcargs` carries the API-key flags to the ARCHIVE
# step. The EXPORT step's auth is injected automatically by gym (2.237) because
# `app_store_connect_api_key` ran and is in the lane context — so we must NOT
# also pass it via `export_xcargs`, or xcodebuild errors
# "-authenticationKeyPath may only be provided once". (An earlier version set
# export_xcargs on the assumption gym didn't auto-inject; CI proved it does.)
#
# Build numbers: both prebuild scripts run `git rev-list --count HEAD`
# independently (app + extension). In CI nothing commits mid-build, so they
# always agree; locally a commit landing between the two stamps mismatched
# CFBundleVersions, which App Store Connect rejects. Policy: UPLOADS HAPPEN
# ONLY FROM CI — local archives are for debugging. CI checkouts need
# fetch-depth: 0 or the count is 1 and ASC rejects the build number.

default_platform(:ios)

# `assert_review_submission_started` queries App Store Connect directly. deliver
# pulls spaceship in anyway, but requiring it here means the Fastfile doesn't
# depend on load order inside another action.
require "spaceship"

# --- snapshot / simctl gem workaround (Xcode 26 CoreSimulator) --------------
# fastlane's `snapshot` action resolves each configured device name to a
# `SimCtl::DeviceType` via the (effectively unmaintained) `simctl` gem, purely
# to confirm every device in the run shares one OS family (iOS/tvOS/watchOS).
# On Xcode 26's CoreSimulator, `SimCtl::Device#devicetype` raises internally
# and its own rescue clause papers over that by returning the raw device.plist
# string instead of a resolved DeviceType — the call site then does
# `device.devicetype.name`, which blows up with "undefined method 'name' for
# an instance of String" (`test_command_generator.rb#get_device_type_with_simctl`).
# The check itself only needs the device *names* (it substring-matches
# "iphone"/"ipad"/"apple tv"/"apple watch"), so bypass the simctl gem entirely
# and answer with what was configured — this is exactly the shortcut fastlane
# itself takes under `Helper.test?`. Harmless on CI's older Xcode where the
# simctl gem still works fine; it just skips a resolution step that would
# have agreed with the raw name anyway.
require "snapshot"
# NOTE: the leading `::` is load-bearing. Fastlane evaluates the Fastfile
# nested inside its own `Fastlane::FastFile` class, so a bare `module
# Snapshot` here would silently define `Fastlane::FastFile::Snapshot` — a
# brand new, disconnected module — instead of reopening the real top-level
# `::Snapshot` from the fastlane gem. Verified via `singleton_class.ancestors`
# during development: without `::` the patched method never runs (the real
# `Snapshot::TestCommandGenerator` code path still executes and still raises).
class ::Snapshot::TestCommandGenerator
  class << self
    def get_device_type_with_simctl(device_names)
      device_names
    end
  end
end

platform :ios do
  # Decode the base64 .p8 from the environment, hand it to fastlane, and
  # return [api_key, auth_args] where auth_args carries the same credentials
  # to xcodebuild for cloud signing.
  private_lane :asc_auth do
    %w[APP_STORE_CONNECT_KEY_ID APP_STORE_CONNECT_ISSUER_ID APP_STORE_CONNECT_KEY_P8].each do |var|
      UI.user_error!("Missing env var #{var} — set it as a GitHub Actions secret") if ENV[var].to_s.empty?
    end

    key_path = File.join(Dir.mktmpdir("asc"), "AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8")
    File.write(key_path, Base64.decode64(ENV["APP_STORE_CONNECT_KEY_P8"]))

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_path
    )

    auth_args = "-allowProvisioningUpdates " \
                "-authenticationKeyPath #{key_path.shellescape} " \
                "-authenticationKeyID #{ENV['APP_STORE_CONNECT_KEY_ID'].shellescape} " \
                "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_ISSUER_ID'].shellescape}"

    { api_key: api_key, auth_args: auth_args }
  end

  # NOTE: App Review Information (demo account, phone, notes) is set BY HAND in
  # App Store Connect, not via deliver — this repo is public and those are
  # secret/PII. The fastlane/metadata/review_information/ folder is git-ignored
  # and absent in CI, so deliver skips the review-info upload entirely. See
  # docs/ios/app-store-review-notes.md.
  private_lane :build_signed do
    auth = asc_auth
    setup_ci if ENV["CI"]
    build_app(
      project: "VMflow.xcodeproj",
      scheme: "VMflow",
      export_method: "app-store",
      xcargs: auth[:auth_args]
      # no export_xcargs — gym auto-injects the API key into the export step
    )
    auth[:api_key]
  end

  desc "Build, sign and upload to TestFlight"
  lane :beta do
    api_key = build_signed
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # Regenerate fastlane/metadata/<locale>/release_notes.txt from the commits
  # since the last ios-v* tag. See ios/scripts/release_notes.rb for the rules
  # and for the `Release-Note-DE:` / `Release-Note: skip` commit trailers.
  private_lane :stamp_release_notes do |options|
    root = sh("git", "rev-parse", "--show-toplevel", log: false).strip
    cmd = ["ruby", File.join(root, "ios", "scripts", "release_notes.rb")]
    cmd += ["--since", options[:since]] unless options[:since].to_s.empty?
    sh(*cmd)
  end

  # deliver treats precheck findings as warnings by default and then simply
  # skips `submit_for_review` when precheck returns false — a green lane with
  # nothing actually in review. The whole point of this lane is never opening
  # App Store Connect, so confirm the submission exists before we call it done.
  private_lane :assert_review_submission_started do
    platform = Spaceship::ConnectAPI::Platform::IOS
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    submitted = false
    verifiable = true

    3.times do |attempt|
      sleep(20) if attempt.positive? # ASC lags a little behind the submit call
      begin
        app = Spaceship::ConnectAPI::App.find(bundle_id)
        submitted = !app.nil? && !app.get_in_progress_review_submission(platform: platform).nil?
      rescue StandardError => e
        # Never fail on a flaky or changed API surface: deliver already reported
        # a successful submission, and a false alarm here would send you to App
        # Store Connect for no reason — exactly what this lane exists to avoid.
        UI.important("Could not verify the review submission (#{e.class}: #{e.message})")
        verifiable = false
      end
      break if submitted || !verifiable
    end

    if submitted
      UI.success("Review submission is in progress; it auto-releases once approved ✅")
    elsif verifiable
      UI.user_error!("deliver finished but no review submission is in progress for #{bundle_id}. " \
                     "Check the precheck output above, then re-run this lane.")
    end
  end

  desc "Build, sign, upload binary + metadata, submit for review, auto-release on approval"
  lane :release do |options|
    # Options (all optional):
    #   notes:keep   use the committed release_notes.txt verbatim instead of
    #                regenerating them (for hand-written notes)
    #   since:REF    generate notes against REF instead of the last ios-v* tag
    #   submit:false upload only, leave the version sitting in ASC (old behaviour)
    #
    # Notes are stamped BEFORE the upload because deliver pushes metadata ahead
    # of the binary (Deliver::Runner#run).
    stamp_release_notes(since: options[:since]) unless options[:notes].to_s == "keep"

    submit = options[:submit].to_s != "false"
    api_key = build_signed

    upload_to_app_store(
      api_key: api_key,
      force: true, # non-interactive CI: the HTML-preview prompt would hard-error
      # deliver selects the freshly uploaded build itself: SubmitForReview
      # waits out build processing and calls version.select_build.
      submit_for_review: submit,
      # true -> releaseType AFTER_APPROVAL: App Store Connect publishes the
      # version the moment review passes, no button to press.
      automatic_release: submit,
      # deliver reads exactly these two keys out of this hash. IDFA and the age
      # rating are app-level answers in ASC now, not per-submission ones, and
      # export compliance is already answered via ITSAppUsesNonExemptEncryption
      # in Info.plist — this only covers the extension's build record.
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      },
      precheck_include_in_app_purchases: false # precheck can't check IAP with an API key
    )

    assert_review_submission_started if submit
  end

  desc "Preview the auto-generated release notes without building or uploading"
  lane :release_notes do |options|
    stamp_release_notes(since: options[:since])
  end

  desc "Upload metadata + screenshots only (no binary)"
  lane :metadata do
    auth = asc_auth
    upload_to_app_store(
      api_key: auth[:api_key],
      force: true,
      skip_binary_upload: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Generate localized App Store screenshots (phase 5)"
  lane :screenshots do |options|
    # Deterministic, offline, from fixtures (-UITestFixtures) — needs no ASC
    # secrets, so it also runs locally without any of the asc_auth env vars.
    #
    # Per-run overrides (both optional; defaults come from the Snapfile):
    #   devices: comma-separated sim names to capture instead of the Snapfile set
    #   clear:   pass clear:false to ADD to the committed PNGs instead of wiping
    # Refresh only the iPad set, keeping the iPhone PNGs:
    #   fastlane screenshots 'devices:iPad Pro 13-inch (M5)' clear:false
    overrides = {}
    overrides[:devices] = options[:devices].split(",").map(&:strip) if options[:devices]
    overrides[:clear_previous_screenshots] = false if options[:clear].to_s == "false"
    capture_screenshots(**overrides)
  end
end
